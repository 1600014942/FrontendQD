{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outFile": "public/app.js",
    "removeComments": true,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts"
  ]
}